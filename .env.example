# 이 파일을 .env로 복사해 값을 채운다: cp .env.example .env
# .env는 git에 올리지 않는다(.gitignore). 실제 비밀값은 이 예시 파일에 적지 않는다.

# PostgreSQL (Docker Compose와 Spring Boot가 함께 쓴다)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=

# Redis (Docker Compose와 Spring Boot가 함께 쓴다)
REDIS_HOST=localhost
REDIS_PORT=6379

# Access Token 서명용 비밀 키. 32자 이상. 비어 있으면 서버가 시작되지 않는다.
# 만드는 법: openssl rand -base64 48
AUTH_JWT_SECRET=
